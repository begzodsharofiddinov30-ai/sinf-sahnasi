{
  "name": "sinf-sahnasi",
  "private": true,
  "version": "1.2.0",
  "description": "Boshlang'ich sinf o'qituvchisi uchun oflayn dars sahnalari (1-4-sinf)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:portable": "tsc --noEmit && vite build --mode portable",
    "build:all": "npm run build && npm run build:portable",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run lint && npm run validate:content && npm test && npm run build",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "5.1.0",
    "@neondatabase/serverless": "0.10.4",
    "framer-motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.13.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.17.0",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
